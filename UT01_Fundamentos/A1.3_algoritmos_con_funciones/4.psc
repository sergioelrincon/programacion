// Algoritmo implementado por Ancor y explicado por Edma
Algoritmo  Comprobacion_denumero
	Comprobacion_par_impar 
	Comprobacion_par_impar
	Comprobacion_par_impar
FinAlgoritmo


Funcion Comprobacion_par_impar
	Definir num Como Entero
	Escribir "Porfavor introduzca un numero para determinar si es par o impar"
	Leer num
	Si num Mod 2 = 0 entonces 
		Escribir "El numero es par"
	SiNo 
		Escribir "El numero es impar"
	FinSi
FinFuncion
	